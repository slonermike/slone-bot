{
  "name": "minigame-bot-host",
  "version": "0.2.1",
  "private": true,
  "description": "Thin Electron shell that runs the minigame-bot launcher full screen on a Steam Deck.",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:windowed": "electron . --windowed",
    "test": "node --test test/config.test.cjs test/updater.test.cjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "dev.slone.minigamebot.host",
    "productName": "Minigame Bot",
    "files": [
      "main.cjs",
      "config.cjs",
      "updater.cjs",
      "preload.cjs",
      "offline.html",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "slonermike",
      "repo": "slone-bot",
      "releaseType": "release"
    },
    "artifactName": "Minigame-Bot-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Minigame-Bot-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    }
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  }
}
